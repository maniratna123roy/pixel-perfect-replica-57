# Bird's Eye Backend Configuration

# WebODM / NodeODM Connection
# If using NodeODM (recommended local setup):
WEBODM_URL=http://localhost:3000
WEBODM_USERNAME=
WEBODM_PASSWORD=
WEBODM_TOKEN=

# Processing Limits (Tuned for 16GB RAM Laptop)
MAX_VIDEO_DURATION_SEC=300
MAX_KEYFRAMES=150
FRAME_EXTRACTION_FPS=2.0
BLUR_THRESHOLD_PERCENTILE=25.0

# Photogrammetry Provider: 'webodm', 'build' (local pycolmap), or 'auto'
DEFAULT_PROVIDER=auto
